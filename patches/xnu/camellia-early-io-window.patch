 SECURITY_READ_ONLY_LATE(addr64_t) first_avail_phys = 0;
 
+/*
+ * Early non-Apple IO window. The final kernel page tables must contain leaf
+ * PTEs before TTBR0 is retired, because early io_map() cannot allocate new
+ * page-table pages through kernel_map.
+ */
+#define CAMELLIA_IO_PHYS_BASE    0x0C000000ULL
+#define CAMELLIA_IO_WINDOW_SIZE  0x01000000ULL
+#define CAMELLIA_FB_WINDOW_SIZE  0x01000000ULL
+#define CAMELLIA_IO_TOTAL_SIZE   (CAMELLIA_IO_WINDOW_SIZE + CAMELLIA_FB_WINDOW_SIZE)
+
+SECURITY_READ_ONLY_LATE(vm_offset_t) camellia_io_window_base = 0;
+SECURITY_READ_ONLY_LATE(vm_offset_t) camellia_fb_window_base = 0;
+SECURITY_READ_ONLY_LATE(vm_offset_t) camellia_fb_phys = 0;
+SECURITY_READ_ONLY_LATE(vm_size_t) camellia_fb_size = 0;
+
+extern vm_offset_t camellia_io_lookup(vm_offset_t pa, vm_size_t size);
+
+static void
+camellia_map_io_pages(tt_entry_t *cpu_ttep, vm_offset_t va,
+    vm_offset_t pa, vm_size_t size)
+{
+	vm_offset_t end = va + size;
+
+	for (; va < end; va += ARM_PGBYTES, pa += ARM_PGBYTES) {
+		tt_entry_t *l1 = &cpu_ttep[L1_TABLE_INDEX(va)];
+		tt_entry_t *l2;
+		tt_entry_t *l2e;
+		pt_entry_t *l3;
+		pt_entry_t pte;
+
+		if ((*l1 & (ARM_TTE_TYPE_MASK | ARM_TTE_VALID)) !=
+		    (ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)) {
+			panic("camellia IO L1 table missing for %p", (void *)va);
+		}
+		l2 = (tt_entry_t *)phystokv(*l1 & ARM_TTE_TABLE_MASK);
+		l2e = &l2[L2_TABLE_INDEX(va)];
+		if ((*l2e & (ARM_TTE_TYPE_MASK | ARM_TTE_VALID)) !=
+		    (ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)) {
+			panic("camellia IO L2 table missing for %p", (void *)va);
+		}
+		l3 = (pt_entry_t *)phystokv(*l2e & ARM_TTE_TABLE_MASK);
+		pte = pa_to_pte(pa)
+		    | ARM_PTE_TYPE_VALID | ARM_PTE_AF | ARM_PTE_NX | ARM_PTE_PNX
+		    | ARM_PTE_AP(AP_RWNA)
+		    | ARM_PTE_ATTRINDX(CACHE_ATTRINDX_DISABLE);
+#if __ARM_KERNEL_PROTECT__
+		pte |= ARM_PTE_NG;
+#endif
+		l3[L3_TABLE_INDEX(va)] = pte;
+	}
+	__builtin_arm_dmb(DMB_ISH);
+	__builtin_arm_isb(ISB_SY);
+}
+
+static void
+camellia_map_io_window(tt_entry_t *cpu_ttep, boot_args *boot_args_ptr)
+{
+	vm_size_t fb_size;
+	vm_offset_t fb_phys;
+
+	camellia_map_io_pages(cpu_ttep, camellia_io_window_base,
+	    CAMELLIA_IO_PHYS_BASE, CAMELLIA_IO_WINDOW_SIZE);
+
+	fb_phys = trunc_page(boot_args_ptr->Video.v_baseAddr & ~3ULL);
+	fb_size = round_page((vm_size_t)boot_args_ptr->Video.v_height *
+	    (vm_size_t)boot_args_ptr->Video.v_rowBytes +
+	    ((boot_args_ptr->Video.v_baseAddr & ~3ULL) & PAGE_MASK));
+	if (fb_phys != 0 && fb_size != 0 && fb_size <= CAMELLIA_FB_WINDOW_SIZE) {
+		camellia_fb_window_base = camellia_io_window_base +
+		    CAMELLIA_IO_WINDOW_SIZE;
+		camellia_fb_phys = fb_phys;
+		camellia_fb_size = fb_size;
+		camellia_map_io_pages(cpu_ttep, camellia_fb_window_base,
+		    camellia_fb_phys, camellia_fb_size);
+	}
+}
+
+vm_offset_t
+camellia_io_lookup(vm_offset_t pa, vm_size_t size)
+{
+	if (camellia_io_window_base != 0 &&
+	    pa >= CAMELLIA_IO_PHYS_BASE &&
+	    pa - CAMELLIA_IO_PHYS_BASE <= CAMELLIA_IO_WINDOW_SIZE &&
+	    size <= CAMELLIA_IO_WINDOW_SIZE - (pa - CAMELLIA_IO_PHYS_BASE)) {
+		return camellia_io_window_base + (pa - CAMELLIA_IO_PHYS_BASE);
+	}
+	if (camellia_fb_window_base != 0 && camellia_fb_size != 0 &&
+	    pa >= camellia_fb_phys &&
+	    pa - camellia_fb_phys <= camellia_fb_size &&
+	    size <= camellia_fb_size - (pa - camellia_fb_phys)) {
+		return camellia_fb_window_base + (pa - camellia_fb_phys);
+	}
+	return 0;
+}
