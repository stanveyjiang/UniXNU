 #include <sys/reboot.h>
 
+static void
+camellia_exec_checkpoint(unsigned int stage)
+{
+	char text[48];
+	static int panic_stage = -2;
+
+	if (panic_stage == -2) {
+		int requested = -1;
+
+		if (!PE_parse_boot_argn("camellia-stage-panic", &requested,
+		    sizeof(requested))) {
+			requested = -1;
+		}
+		panic_stage = requested;
+	}
+	if (panic_stage >= 0 && stage == (unsigned int)panic_stage) {
+		panic("CAMUNIXNU exec stage %u reached", stage);
+	}
+	snprintf(text, sizeof(text), "CAMUNIXNU exec stage %u", stage);
+	boot_progress_stage_sync(text);
+}
