diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7006,6 +7006,28 @@
 
 #include <sys/reboot.h>
 
+extern vm_offset_t camellia_fb_window_base;
+extern vm_size_t camellia_fb_size;
+
+static void
+camellia_pid1_exec_checkpoint(int error)
+{
+	volatile uint32_t *fb;
+	vm_size_t bytes;
+
+	if (camellia_fb_window_base == 0 || camellia_fb_size < 4) {
+		return;
+	}
+	fb = (volatile uint32_t *)(uintptr_t)camellia_fb_window_base;
+	bytes = MIN((vm_size_t)0x10000, camellia_fb_size);
+	for (vm_size_t offset = 0; offset + sizeof(uint32_t) <= bytes;
+	    offset += sizeof(uint32_t)) {
+		fb[offset / sizeof(uint32_t)] =
+		    error == 0 ? 0xFFFFFF00 : 0xFF00FFFF;
+	}
+	__builtin_arm_dmb(DMB_ISH);
+}
+
 /*
  * load_init_program_at_path
  *
@@ -7090,7 +7108,10 @@ load_init_program_at_path(proc_t p, user_addr_t scratch_addr, const char* path)
 	 */
 	set_security_token(p, proc_ucred_unsafe(p));
 
-	return execve(p, &init_exec_args, retval);
+	int result = execve(p, &init_exec_args, retval);
+
+	camellia_pid1_exec_checkpoint(result);
+	return result;
 }
 
 static const char * init_programs[] = {
